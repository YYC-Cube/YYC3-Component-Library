{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "incremental": false,
    "baseUrl": ".",
    "paths": {
      "@/components/ui/*": ["../ui/src/*"],
      "@/components/*": ["./src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": ["node_modules",
    "dist", "src/**/__tests__/**"]
}
