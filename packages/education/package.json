{
  "name": "@yyc3/education",
  "version": "1.0.1",
  "description": "YYC³ 教育学习组件 - 在线教育与学习平台组件集合",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/education",
    "test:coverage": "vitest run --root ../.. --config vitest.config.ts --coverage.enabled --coverage.provider=istanbul --coverage.include='packages/education/src/**' packages/education",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "@yyc3/lib": "^0.4.0",
    "@yyc3/model-adapter": "^1.1.0",
    "@yyc3/theme": "^2.2.0",
    "@yyc3/ui": "^2.1.2",
    "eventemitter3": "^5.0.1",
    "lucide-react": "^0.454.0",
    "openai": "^4.104.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "next": "^15.0.0",
    "next-themes": "^0.4.6",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dnd-touch-backend": "^16.0.1",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsup": "^8.3.5",
    "typescript": "^5.9"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
