{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": false
  },
  // type-check / build 仅收敛到包入口 src/index.ts。
  // 该包是整应用误迁（440 个 src 顶层条目：app/、admin/、modules/、monitoring/、
  // 大量 *Page.tsx），缺失 next、framer-motion、lucide-react 等运行时与
  // src/lib/types、src/lib/data 等上游根文件，整包 7,190 错。
  // 已在 src/index.ts【技术债登记】中记录，待按组件库口径重新抽取，不纳入本包门禁。
  "include": [
    "src/index.ts"
  ],
  "exclude": ["node_modules",
    "dist", "src/**/__tests__/**"]
}
