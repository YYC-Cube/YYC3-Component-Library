{
  "name": "@yyc3/layouts",
  "version": "1.0.1",
  "description": "YYC³ 布局组件库 - Sidebar, Header, Navigation 等布局组件",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.2",
    "@yyc3/lib": "^0.4.0",
    "@yyc3/ui": "^2.1.2",
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.454.0",
    "next": "^15.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "tsup": "^8.3.0",
    "typescript": "^5.9"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
