{
  "name": "yyc3-component-library",
  "version": "1.0.0",
  "private": true,
  "description": "YYC³ 统一组件库 - 企业级 React 组件集合（pnpm + Turborepo Monorepo，15 业务域分包）",
  "keywords": [
    "yyc3",
    "yanyucloudcube",
    "ai-family",
    "component-library",
    "design-system",
    "react",
    "typescript",
    "monorepo",
    "turborepo",
    "pnpm",
    "storybook",
    "vitest",
    "shadcn-ui",
    "radix-ui"
  ],
  "scripts": {
    "dev": "pnpm --filter storybook dev",
    "build": "pnpm -r build",
    "build:ui": "pnpm --filter @yyc3/ui build",
    "build:theme": "pnpm --filter @yyc3/theme build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "test": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:watch": "vitest --project unit",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.5.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-plugin-storybook": "^10.5.4",
    "jsdom": "^30.1.3",
    "playwright": "^1.61.1",
    "prettier": "^3",
    "storybook": "^10.6.2",
    "turbo": "^2.0.0",
    "typescript": "^5.9",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "valibot@<=1.4.1": ">=1.4.2",
      "brace-expansion@<1.1.17": ">=1.1.17",
      "fast-uri@>=3.0.0 <3.1.5": ">=3.1.5",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "brace-expansion@<1.1.18": ">=1.1.18",
      "js-yaml@>=3.0.0 <3.15.1": ">=3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1",
      "nanoid@<3.3.18": ">=3.3.18",
      "fast-uri@>=3.1.3 <3.1.6": ">=3.1.6",
      "fast-uri@>=3.0.0 <3.1.6": ">=3.1.6",
      "fast-uri@>=3.1.2 <3.1.6": ">=3.1.6",
      "colord@<2.9.4": ">=2.9.4",
      "@vitest/mocker@>=2.1.0 <4.1.11": ">=4.1.11",
      "js-yaml@>=3.0.0 <3.15.2": ">=3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2",
      "fast-uri@>=3.0.0 <3.1.7": ">=3.1.7",
      "fast-uri@>=3.0.0 <3.1.8": ">=3.1.8",
      "brace-expansion@<1.1.21": ">=1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": ">=5.0.12",
      "brace-expansion@<1.1.20": ">=1.1.20",
      "brace-expansion@>=4.0.0 <5.0.11": ">=5.0.11",
      "brace-expansion@<1.1.19": ">=1.1.19",
      "brace-expansion@>=4.0.0 <5.0.10": ">=5.0.10",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2",
      "@vitest/mocker@>=2.1.0-beta.7 <4.1.12": ">=4.1.12",
      "fast-uri@>=3.0.0 <3.1.9": ">=3.1.9",
      "fast-uri@>=3.1.3 <3.1.9": ">=3.1.9",
      "postcss-selector-parser@>=7.0.0 <7.1.6": ">=7.1.6",
      "minimatch@<11.0.1": ">=11.0.1",
      "glob@>=9.0.0 <=14.0.1": ">=14.0.2"
    }
  }
}
